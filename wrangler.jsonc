{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gnu-guru",
  "account_id": "b6d1478423f0bb0c0477df387305e46b",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "gnu.guru/*", "zone_name": "gnu.guru" },
    { "pattern": "www.gnu.guru/*", "zone_name": "gnu.guru" }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "main": "src/worker.mjs"
}
